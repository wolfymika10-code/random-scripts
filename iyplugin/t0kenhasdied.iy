local leakifyconnection : RBXScriptSignal? = nil

local function liveleakify(args, speaker)
    local hui = gethui() -- not gonna pcall this because most normal exps have hui

    local function hwenTheGui()
        local ui = Instance.new("ScreenGui")
        ui.Name = "only sigma hackers can read this B)"
        ui.Parent = hui
        ui.ResetOnSpawn = false

        local img = Instance.new("ImageLabel", ui)
        img.Image = "rbxassetid://130901207917297" -- public asset, praying it wont go
        img.Size = Udim2.new(0.25, 0, 0.35, 0) -- unchecked scales
    end

    hwenTheGui()

    local Run = game:GetService("RunService")

    local Cam = game.Workspace.Camera
    local MAGIC_FORMULA = CFrame.new(0, 0, 0, 1, 0, 0, 0, 0.5, 0, 0, 0, 1)

    Run.RenderStepped:Connect(function()
        if not hui:FindFirstChild("only sigma hackers can read this B)") then
            hwenTheGui()
        end
        Cam.CFrame = Cam.CFrame * MAGICFORMULA
    end)
end

local function unleakify(args, speaker)
    if leakifyconnection then
        leakifyconnection:Disconnect()
    end
    if gethui():FindFirstChild("only sigma hackers can read this B)") then
        gethui():FindFirstChild("only sigma hackers can read this B)"):Destroy()
    end
    workspace.CurrentCamera.CFrame = CFrame.new(0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1)
end

