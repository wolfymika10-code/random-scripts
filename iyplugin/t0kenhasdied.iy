local leakifyconnection : RBXScriptSignal? = nil

local function liveleakify(args, speaker)
    local hui = gethui() -- not gonna pcall this because most normal exps have hui (hopefully)

    local function hwenTheGui()
        local ui = Instance.new("ScreenGui")
        ui.Name = "only sigma hackers can read this B)"
        ui.Parent = hui
        ui.ResetOnSpawn = false

        local img = Instance.new("ImageLabel", ui)
        img.Image = "rbxassetid://130901207917297" -- public asset, praying it wont go
        img.Size = UDim2.new(0.25, 0, 0.35, 0) -- unchecked scales
        img.BackgroundTransparency = 1

        return ui
    end

    hwenTheGui()

    local Run = game:GetService("RunService")

    local Cam = game.Workspace.Camera
    local MAGIC_FORMULA = CFrame.new(0, 0, 0, 1, 0, 0, 0, 0.5, 0, 0, 0, 1)

    leakifyconnection = Run.RenderStepped:Connect(function() -- this bug costed me so much hours, thank you luau
        if not hui:FindFirstChild("only sigma hackers can read this B)") then
            hwenTheGui()
        end
        Cam.CFrame = Cam.CFrame * MAGIC_FORMULA
    end)
end

local function unleakify(args, speaker)
    if leakifyconnection then
        leakifyconnection:Disconnect()
    end
    if gethui():FindFirstChild("only sigma hackers can read this B)") then
        gethui():FindFirstChild("only sigma hackers can read this B)"):Destroy()
    end
    workspace.CurrentCamera.CFrame = CFrame.new(0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1)
end

local function UPDATE()
    -- installer isnt working for some reason
    local updatestatus = nil
    local reason = nil

    local ok, content = pcall(function()
         return game:HttpGet("https://raw.githubusercontent.com/wolfymika10-code/random-scripts/refs/heads/main/iyplugin/t0kenhasdied.iy")
    end)

    if ok then
        updatestatus = "fetched"
    else
        updatestatus = "failed"
        reason = content
    end

    if updatestatus == "fetched" then
        -- compare version logic here, probably read fetched code from github...
        -- ...and get the first line, string splitted by spaces, get the...
        -- ...second value and remove the first two characters to get the..
        -- ...final, compareable version (that was a mouthful).

        -- changed it a bit but its got the same idea really

        -- comparsion logic

        -- yes yes gpt coded dont care
        local function findLineWithPattern(text, pattern)
            -- Iterate through every line in the string (handling both LF and CRLF line endings)
            for line in text:gmatch("[^\r\n]+") do
                -- Check if the line contains your pattern
                if line:match(pattern) then
                    -- returns the first orrurance
                    return line
                end
            end
            
            error("line not found")
        end
        
        -- morning-after patch, will require a full reinstall :c
        local ln1 = findLineWithPattern(content, "local pluginversion=")
        local versionnum = tonumber(string.split(ln1, "=")[2])

        local needsupdate = nil

        if not versionnum then
            notify("failed to get version number, contact<<< dev")
            return
        end

        if versionnum>pluginversion then
            needsupdate = true
        else
            needsupdate = false
        end

        if needsupdate then
            local writefilesuccess = pcall(function()
                writefile(".tmp", "temp") -- fixed, writefile doesnt return anything
            end)
            if not writefilesuccess then
                notify("no writefile", "Your executor enviroment does not include the writefile function (check whatexpsare.online)")
                return
            else
                writefile("t0kenhasdied.iy", content)
            end
            if writefilesuccess then
                notify("Dumped plugin to disc successfully, attempting reload in a few seconds...")
                task.wait(3)
                execCmd("reloadplugin t0kenhasdied")
                -- the reason this may not be working is because reload just...
                -- ...resets it from memory rather than re-reading file itself...
                -- ...check tommorrow if this is the reason why (just incase)...
                -- ...read the infyiff source code if you gotta
            else
                notify("writefile failed :( heres what we know: " .. failreason)
                return
            end
        else
            notify("No outstanding updates.")
        end
    elseif updatestatus == "failed" then
        notify("failed to get update: " .. reason)
        return
    end
end

local function downloadAsset(args, speaker)
    local name = args[1]
    local url = args[2]

    if name and url then
        --pass
    else
        notify("you need 2 arguments to use download")
    end

    local writefilesuccess = pcall(function()
        writefile(".tmp", "temp")
    end)

    if not writefilesuccess then
        notify("no writefile", "Your executor enviroment does not include the writefile function (check whatexpsare.online)")
        return
    else
        writefile(name, game:HttpGet(url))
    end
end

